# Copy to .env and adjust. All variables are optional; defaults are shown.
CIFAR_DATA_DIR=data/raw
CIFAR_PARAMS_PATH=config/params.toml
CIFAR_MODELS_DIR=models
CIFAR_MODEL_PATH=models/resnet.pt
CIFAR_REPORTS_DIR=reports
CIFAR_DEVICE=auto
CIFAR_API_HOST=127.0.0.1
CIFAR_API_PORT=8000
CIFAR_MAX_BATCH_SIZE=64
CIFAR_MAX_UPLOAD_BYTES=2000000
CIFAR_LOG_LEVEL=info
# docker compose: published host port and the experiment the train service runs
CIFAR_HOST_PORT=8000
CIFAR_TRAIN_EXPERIMENT=resnet
